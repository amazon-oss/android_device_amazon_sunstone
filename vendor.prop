# Dalvik
dalvik.vm.dex2oat64.enabled=true

# Display
debug.mediatek.disp_decompress=1
ro.hardware.egl=mali
ro.opengles.version=196610
ro.vendor.mtk_hdr_video_support=1
ro.vendor.mtk_pq_color_mode=1
ro.vendor.mtk_pq_support=2

# Recovery
ro.minui.blacklist_input_devices=ilitek_hid-over-i2c 222A:FFF1 Stylus

# SurfaceFlinger
debug.sf.enable_hwc_vds=1
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3

# USB
vendor.usb.controller=112b1000.usb
