type vendor_init_btmac, domain;
type vendor_init_btmac_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_init_btmac)

allow vendor_init_btmac vendor_toolbox_exec:file rx_file_perms;

r_dir_file(vendor_init_btmac, vendor_proc_idme)

allow vendor_init_btmac vendor_data_file:dir search;
allow vendor_init_btmac bt_data_file:dir rw_dir_perms;
allow vendor_init_btmac bt_data_file:file create_file_perms;
