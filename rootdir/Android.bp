prebuilt_etc {
    name: "fstab.emmc",
    src: "etc/fstab.emmc",
    vendor: true,
    vendor_ramdisk_available: true,
}

sh_binary {
    name: "init.insmod.sh",
    src: "bin/init.insmod.sh",
    vendor: true,
}

prebuilt_etc {
    name: "init.mt8188.rc",
    src: "etc/init.mt8188.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd.mt8188.rc",
    filename: "ueventd.rc",
    src: "etc/ueventd.mt8188.rc",
    vendor: true,
}
