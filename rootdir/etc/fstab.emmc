# <src>                                          <mnt_point>                 <type>  <mnt_flags and options>                                             <fs_mgr_flags>
system                                           /system                     ext4    ro                                                                  wait,avb=vbmeta,logical,first_stage_mount
system_ext                                       /system_ext                 ext4    ro                                                                  wait,avb,logical,first_stage_mount
product                                          /product                    ext4    ro                                                                  wait,avb,logical,first_stage_mount
vendor                                           /vendor                     ext4    ro                                                                  wait,avb,logical,first_stage_mount

/dev/block/by-name/metadata                      /metadata                   ext4    noatime,nosuid,nodev                                                wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata                      /data                       ext4    noatime,nosuid,nodev,noauto_da_alloc,errors=remount-ro,inlinecrypt  wait,check,formattable,quota,latemount,reservedsize=128m,checkpoint=block,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/cache                         /cache                      ext4    noatime,nosuid,nodev,noauto_da_alloc,discard                        wait,check,formattable
/dev/block/by-name/nvcfg                         /mnt/vendor/nvcfg           ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc            wait,check,formattable
/dev/block/by-name/nvdata_persist                /mnt/vendor/nvdata_persist  ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc            wait,check,formattable

/devices/platform/11240000*                      auto                        auto    defaults                                                            voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/112b1000.usb/112b0000.xhci*    auto                        vfat    defaults                                                            voldmanaged=usbotg:auto
/devices/platform/11201000.usb1/11200000.xhci1*  auto                        vfat    defaults                                                            voldmanaged=usbotg:auto
/devices/platform/112a1000.usb2/112a0000.xhci2*  auto                        vfat    defaults                                                            voldmanaged=usbotg:auto

/dev/block/by-name/boot                          /boot                       emmc    defaults                                                            defaults
/dev/block/by-name/dtbo                          /dtbo                       emmc    defaults                                                            defaults
/dev/block/by-name/misc                          /misc                       emmc    defaults                                                            defaults
/dev/block/by-name/recovery                      /recovery                   emmc    defaults                                                            defaults
/dev/block/by-name/vbmeta                        /vbmeta                     emmc    defaults                                                            defaults
/dev/block/by-name/vendor_boot                   /vendor_boot                emmc    defaults                                                            defaults
